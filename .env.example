# Copy to .env. Read at startup; restart after changing settings.
# Local analyst works without API keys.
WINDAGENT_CHAT_PROVIDER=local

# Optional generative chat via OpenAI. Supply YOUR model ID and key locally.
# Current forecast + short conversation are sent only in this explicit mode.
# Raw datasets are never sent. Do not commit .env.
# WINDAGENT_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Strict historical availability. Delivered hindcast cache fails this check
# by design, because contemporaneous publication is not verified.
WINDAGENT_STRICT_AS_OF=0

# Periodically refresh the current forecast every five minutes. Set to 0 to disable.
WINDAGENT_LIVE_POLL=1
